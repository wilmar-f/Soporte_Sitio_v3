<!DOCTYPE html>
<!--
  diagnostico.template.html — Formato FR-BAI09.11 v1
  Encabezado y pie FUERA del borde; borde solo en tabla central.
-->
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    @page {
      size: letter;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Calibri, 'Segoe UI', Arial, sans-serif;
      font-size: 11pt;
      color: #000;
      background: #fff;
      width: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    .pdf-doc {
      width: 100%;
      max-width: 100%;
      padding-top: 4px;
    }

    /* ── Encabezado en 2 filas ─────────────────────── */
    .header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
      gap: 8px;
    }
    .header-row--second {
      margin-bottom: 8px;
    }
    .header-col-left {
      width: 18%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }
    .header-col-left img {
      height: 36px;
      max-width: 84px;
      object-fit: contain;
    }
    .header-col-center {
      flex: 1;
      text-align: center;
      padding: 0 8px;
    }
    .header-col-right {
      width: 25%;
      flex-shrink: 0;
      text-align: right;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12pt;
      line-height: 1.45;
    }
    .header-col-right--empty {
      /* mantiene alineación en fila 2 */
    }
    .header-formato-titulo {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12pt;
      font-weight: 700;
      color: #000;
      line-height: 1.3;
    }
    .header-formato-subtitulo {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12pt;
      font-weight: 700;
      color: #8E8E8E;
      line-height: 1.3;
    }
    .header-titulo-principal {
      font-family: Calibri, 'Segoe UI', Arial, sans-serif;
      font-size: 16pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      line-height: 1.15;
      color: #000;
    }

    /* ── Tabla central (bordes solo en celdas, sin marco duplicado) ─── */
    .plantilla-wrapper {
      border: none;
      box-sizing: border-box;
    }

    /* ── Tabla principal ──────────────────────────── */
    .tabla-diagnostico {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      border: 2px solid #000;
    }

    .tabla-diagnostico td {
      border: 2px solid #000;
      padding: 4px 5px;
      vertical-align: middle;
      font-size: 11pt;
      line-height: 1.3;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .th-seccion {
      background: #D0CECE;
      font-weight: 700;
      font-size: 11pt;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-align: left;
      white-space: nowrap;
      line-height: 1.2;
      padding: 3px 6px !important;
      vertical-align: middle;
    }

    .th-seccion-contenido {
      text-align: left;
      vertical-align: middle;
      padding: 6px 8px !important;
      line-height: 1.2;
      white-space: normal;
    }

    .th-seccion-contenido-compact {
      padding: 2px 6px !important;
      line-height: 1.1;
    }

    .th-label {
      background: #fff;
      font-weight: 700;
      font-size: 11pt;
      white-space: normal;
      word-break: break-word;
      padding: 3px 6px !important;
      vertical-align: middle;
    }

    .th-label-una-linea {
      text-align: left;
      white-space: nowrap;
      line-height: 1.2;
      padding: 3px 6px !important;
    }

    .th-label-procesador {
      text-align: left;
      white-space: nowrap;
      line-height: 1.2;
      padding: 3px 6px !important;
    }

    .th-label-apps-uso {
      text-align: left;
      white-space: normal;
      line-height: 1.15;
      height: 28px;
      vertical-align: middle;
      padding: 3px 6px !important;
    }

    /* TEST / INTERCAMBIO / RAZÓN — sin negrita, sin relleno gris */
    .th-label-sin-relleno {
      background: #fff !important;
      font-weight: 400;
      font-size: 11pt;
      white-space: normal;
      word-break: break-word;
      padding: 4px 5px !important;
      vertical-align: middle;
      line-height: 1.2;
    }

    .td-valor {
      background: #fff;
      word-break: break-word;
      overflow-wrap: anywhere;
      vertical-align: middle;
    }

    .td-valor-una-linea {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .td-valor-wrap-2 {
      white-space: normal;
      word-break: break-word;
      overflow-wrap: anywhere;
      line-height: 1.15;
    }

    .td-valor-centro {
      text-align: center !important;
    }

    .td-valor-centro .valor-centrado {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      text-align: center;
    }

    .tbody-compact td {
      padding: 2px 4px !important;
      line-height: 1.15;
      border-width: 1px;
    }
    .tbody-compact .th-label {
      font-weight: 400;
    }
    .tbody-compact .th-seccion {
      padding: 2px 5px !important;
      line-height: 1.1;
    }
    .tbody-compact .th-label-apps-uso {
      height: 22px;
    }

    .td-texto-grande {
      vertical-align: middle;
      padding: 6px 8px !important;
      white-space: pre-wrap;
      word-break: break-word;
      line-height: 1.3;
      font-size: 11pt;
      background: #fff;
    }
    .td-texto-falla    { height: 70px; }
    .td-texto-acciones { height: 80px; }
    .td-texto-diag     { height: 70px; }

    /* Celda combinada izquierda de PARÁMETROS */
    .td-parametros-merge {
      background: #D0CECE;
    }

    .th-label-param {
      background: #D0CECE;
      text-align: center;
      font-weight: 700;
    }

    .tabla-diagnostico td.th-label-param-compact {
      white-space: nowrap;
      font-size: 9pt !important;
      padding: 1px 1px !important;
      line-height: 1.05;
      text-align: center;
    }

    /* ── Pie de página (fuera del borde) ───────────── */
    .page-footer {
      margin-top: 8px;
      margin-bottom: 8px;
    }

    .footer-tecnico {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0;
      border-spacing: 0;
    }
    .footer-tecnico td {
      border: none;
      padding: 0;
      font-size: 11pt;
      line-height: 1.15;
      vertical-align: bottom;
    }
    .footer-tecnico .footer-label {
      background: transparent;
      font-weight: 700;
      width: 72px;
      padding: 0 8px 0 0 !important;
      border: none;
      white-space: nowrap;
      vertical-align: bottom;
    }
    .footer-tecnico .footer-valor {
      background: transparent;
      padding: 0 !important;
      border: none;
      vertical-align: bottom;
    }
    .footer-tecnico .footer-firma-line {
      display: inline-block;
      min-width: 140px;
      max-width: 180px;
      min-height: 28px;
      border-bottom: 1px solid #000;
      padding-bottom: 2px;
      vertical-align: bottom;
    }
    .footer-tecnico .footer-firma-line img {
      max-height: 34px;
      max-width: 160px;
      object-fit: contain;
      display: block;
    }
  </style>
</head>
<body>

<div class="pdf-doc">

<!-- ══ ENCABEZADO — fila 1 (sin borde exterior) ═══════ -->
<div class="header-row">
  <div class="header-col-left">
    <img src="{{logo1Src}}" alt="Corbeta">
  </div>
  <div class="header-col-center">
    <div class="header-formato-titulo">Formato</div>
    <div class="header-formato-subtitulo">DIAGNÓSTICO DE ACTIVOS SOPORTE EN SITIO</div>
  </div>
  <div class="header-col-right">
    <strong>Código:</strong> FR-BAI09.11<br>
    <strong>Versión:</strong> 1
  </div>
</div>

<!-- ══ ENCABEZADO — fila 2 ════════════════════════════ -->
<div class="header-row header-row--second">
  <div class="header-col-left">
    <img src="{{logo2Src}}" alt="Corbeta">
  </div>
  <div class="header-col-center">
    <div class="header-titulo-principal">FORMATO DE DIAGNÓSTICO</div>
  </div>
  <div class="header-col-right header-col-right--empty">&nbsp;</div>
</div>

<!-- ══ TABLA CON BORDE ══════════════════════════════════ -->
<div class="plantilla-wrapper">
<table class="tabla-diagnostico">
  <colgroup>
    <col style="width:30%">
    <col style="width:14%">
    <col style="width:12%">
    <col style="width:19%">
    <col style="width:14.5%">
    <col style="width:13.5%">
  </colgroup>

  <tbody class="tbody-compact">
  <!-- UBICACIÓN Y FECHA -->
  <tr>
    <td colspan="6" class="th-seccion">UBICACIÓN Y FECHA</td>
  </tr>
  <tr>
    <td class="th-label">SEDE</td>
    <td class="td-valor td-valor-centro" colspan="2">{{sede}}</td>
    <td class="th-label">FECHA</td>
    <td class="td-valor" colspan="2">{{fecha}}</td>
  </tr>

  <!-- DATOS DEL USUARIO -->
  <tr>
    <td colspan="6" class="th-seccion">DATOS DEL USUARIO</td>
  </tr>
  <tr>
    <td class="th-label">Nombre usuario</td>
    <td class="td-valor td-valor-wrap-2 td-valor-centro" colspan="2">{{nombreUsuario}}</td>
    <td class="th-label">Área del usuario</td>
    <td class="td-valor" colspan="2">{{areaUsuario}}</td>
  </tr>
  <tr>
    <td class="th-label">Cédula</td>
    <td class="td-valor td-valor-centro" colspan="2">{{cedula}}</td>
    <td class="th-label">Ubicación física</td>
    <td class="td-valor" colspan="2">{{ubicacionFisica}}</td>
  </tr>

  <!-- DATOS DE EQUIPOS -->
  <tr>
    <td colspan="6" class="th-seccion">DATOS DE EQUIPOS</td>
  </tr>
  <tr>
    <td class="th-label">Marca</td>
    <td class="td-valor td-valor-centro" colspan="2">{{marca}}</td>
    <td class="th-label">Serial</td>
    <td class="td-valor" colspan="2">{{serial}}</td>
  </tr>
  <tr>
    <td class="th-label">Modelo</td>
    <td class="td-valor td-valor-centro" colspan="2">{{modelo}}</td>
    <td class="th-label">Etiqueta</td>
    <td class="td-valor" colspan="2">{{etiqueta}}</td>
  </tr>

  <!-- CARACTERÍSTICAS DEL EQUIPO -->
  <tr>
    <td colspan="6" class="th-seccion">CARACTERÍSTICAS DEL EQUIPO</td>
  </tr>
  <tr>
    <td class="th-label th-label-procesador">Procesador Tipo y Velocidad</td>
    <td class="td-valor td-valor-centro" colspan="2"><div class="valor-centrado">{{procesador}}</div></td>
    <td class="th-label th-label-una-linea">Versión SO</td>
    <td class="td-valor" colspan="2">{{versionSO}}</td>
  </tr>
  <tr>
    <td class="th-label">RAM</td>
    <td class="td-valor td-valor-centro" colspan="2">{{ram}}</td>
    <td class="th-label th-label-una-linea">Nombre del equipo</td>
    <td class="td-valor" colspan="2">{{nombreEquipo}}</td>
  </tr>
  <tr>
    <td class="th-label th-label-una-linea">Sistema Operativo</td>
    <td class="td-valor td-valor-centro" colspan="2">{{sistemaOperativo}}</td>
    <td class="th-label th-label-una-linea">Versión de Office</td>
    <td class="td-valor" colspan="2">{{versionOffice}}</td>
  </tr>
  <tr>
    <td class="th-label">HD</td>
    <td class="td-valor td-valor-centro" colspan="2">{{hd}}</td>
    <td class="th-label th-label-apps-uso" rowspan="2">Mencione las aplicaciones de mayor uso</td>
    <td class="td-valor" rowspan="2" colspan="2">{{appsMayorUso}}</td>
  </tr>
  <tr>
    <td class="th-label th-label-una-linea">Aplicaciones Fuera del Estándar</td>
    <td class="td-valor td-valor-centro" colspan="2">{{appsFueraEstandar}}</td>
  </tr>
  </tbody>

  <tbody class="tbody-normal">
  <!-- DESCRIPCIÓN DE LA FALLA -->
  <tr>
    <td colspan="6" class="th-seccion th-seccion-contenido th-seccion-contenido-compact">DESCRIBA LA FALLA QUE PRESENTA EL EQUIPO</td>
  </tr>
  <tr>
    <td colspan="6" class="td-texto-grande td-texto-falla">{{descripcionFalla}}</td>
  </tr>

  <!-- ACCIONES REALIZADAS -->
  <tr>
    <td colspan="6" class="th-seccion th-seccion-contenido th-seccion-contenido-compact">ACCIONES REALIZADAS PARA TRATAR DE SOLUCIONAR LA FALLA</td>
  </tr>
  <tr>
    <td colspan="6" class="td-texto-grande td-texto-acciones">{{accionesRealizadas}}</td>
  </tr>

  <!-- DIAGNÓSTICO FINAL -->
  <tr>
    <td colspan="6" class="th-seccion th-seccion-contenido th-seccion-contenido-compact">DESCRIBA EL DIAGNÓSTICO LUEGO DE LAS ACCIONES REALIZADAS.</td>
  </tr>
  <tr>
    <td colspan="6" class="td-texto-grande td-texto-diag">{{diagnosticoFinal}}</td>
  </tr>

  <!-- PARÁMETROS / TEST DEL FABRICANTE -->
  <tr>
    <td colspan="3" rowspan="2" class="td-parametros-merge"></td>
    <td colspan="3" class="th-label th-label-param">PARÁMETROS</td>
  </tr>
  <tr>
    <td class="th-label th-label-param th-label-param-compact">REALIZADO (SI - NO)</td>
    <td class="th-label th-label-param th-label-param-compact">VERSION - NOMBRE</td>
    <td class="th-label th-label-param th-label-param-compact">RESULTADO TEST</td>
  </tr>
  <tr>
    <td colspan="3" class="th-label-sin-relleno">
      TEST DEL FABRICANTE (LENOVO-HEWLETT PACKARD) AL DISPOSITIVO EN CONFLICTO
    </td>
    <td class="td-valor" style="text-align:center;">{{testFabricanteRealizado}}</td>
    <td class="td-valor" style="text-align:center;">{{testFabricanteVersion}}</td>
    <td class="td-valor" style="text-align:center;">{{testFabricanteResultado}}</td>
  </tr>
  <tr>
    <td colspan="3" class="th-label-sin-relleno">
      SE REALIZÓ INTERCAMBIO DE PARTES (DISCO DURO, MEMORIAS, FUENTE, BATERÍA, CARGADOR, ETC.), CUÁL PARTE Y EL RESULTADO:
    </td>
    <td colspan="3" class="td-valor">{{intercambioPartes}}</td>
  </tr>
  <tr>
    <td colspan="3" class="th-label-sin-relleno">
      RAZÓN DE SOLICITUD DIFERENTES A FALLAS DE HARDWARE
    </td>
    <td colspan="3" class="td-valor">{{razonSolicitud}}</td>
  </tr>
  </tbody>

</table>
</div><!-- /.plantilla-wrapper -->

<!-- ══ PIE DE PÁGINA (sin borde) ════════════════════════ -->
<div class="page-footer">
  <table class="footer-tecnico">
    <tr>
      <td class="footer-label">Firma</td>
      <td class="footer-valor">
        <span class="footer-firma-line">{{{firmaImg}}}</span>
      </td>
    </tr>
    <tr>
      <td class="footer-label">NOMBRE</td>
      <td class="footer-valor">{{nombreTecnico}}</td>
    </tr>
    <tr>
      <td class="footer-label">CÉDULA</td>
      <td class="footer-valor">{{cedulaTecnico}}</td>
    </tr>
    <tr>
      <td class="footer-label">CARGO</td>
      <td class="footer-valor">{{cargoTecnico}}</td>
    </tr>
  </table>
</div>

</div><!-- /.pdf-doc -->

</body>
</html>
